# DataJud CNJ — chave pública (rotacionada periodicamente pelo CNJ)
# Fonte: https://datajud-wiki.cnj.jus.br/api-publica/acesso/
DATAJUD_API_KEY=cDZHYzlZa0JadVREZDJCendQbXY6SkJlTzNjLV9TRENyQk1RdnFKZGRQdw==

# Telegram Bot — crie em @BotFather no Telegram
TELEGRAM_BOT_TOKEN=seu_token_aqui
TELEGRAM_CHAT_ID=seu_chat_id_aqui

# Upstash Redis — https://upstash.com (free: 10k req/dia)
# Compatível com @vercel/kv — configure via painel Vercel → Storage → KV
# OU use Upstash direto: https://console.upstash.com
KV_URL=
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=

# Segurança do cron — string aleatória de 32+ caracteres
# O Vercel injeta automaticamente em chamadas de cron quando definido
# Para uso externo (cron-job.org): passar como header "Authorization: Bearer SEU_SECRET"
CRON_SECRET=

# --- OPCIONAL: cron-job.org (vercel hobby = 1x/hora; cron-job.org = a cada 15min grátis)
# Crie uma conta em https://cron-job.org
# URL: https://SEU-APP.vercel.app/api/cron/monitorar
# Header: Authorization: Bearer SEU_CRON_SECRET
# Intervalo: 15 minutos

# ============================================================
# Plataforma Di Pallacio Enterprise (distrato de multipropriedade)
# ============================================================

# PostgreSQL — local (docker/postgres) ou gerenciado (Supabase/Neon)
DATABASE_URL="postgresql://usuario:senha@localhost:5432/dipallacio_dev"

# NextAuth — gere um valor com `openssl rand -base64 32`
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Número de WhatsApp do escritório para o botão flutuante e o link wa.me (só dígitos, com DDI)
WHATSAPP_NUMERO=5581996232353

# E-mail para onde os leads são encaminhados (opcional, v1 usa apenas o painel admin)
LEADS_EMAIL_DESTINO=pjetjpe@gmail.com

# Necessário para o upload opcional de contrato em PDF no formulário de distrato.
# Crie em Vercel → seu projeto → Storage → Create Database → Blob (gera o token automaticamente).
BLOB_READ_WRITE_TOKEN=

# --- Calculadora pública e relatório pago (R$ 9,90) ---------------------------------------------
# Preço do relatório em centavos (990 = R$ 9,90). Definido no servidor; o navegador nunca envia valor.
PRECO_RELATORIO_CENTAVOS=990

# O PAGAMENTO FICA DESLIGADO enquanto nenhuma das opções abaixo estiver configurada
# (a calculadora segue gratuita e coleta interesse/lista de espera).
#
# Opção A — Pix manual (conferência no painel /admin/pedidos): preencha os três campos.
PIX_CHAVE=
PIX_RECEBEDOR_NOME=
PIX_CIDADE=
#
# Opção B — Mercado Pago Checkout Pro (confirmação automática). Crie a conta, gere o Access Token de
# produção e cadastre o webhook: https://SEU-SITE/api/pagamentos/mercadopago/webhook
MERCADOPAGO_ACCESS_TOKEN=

# CRON_SECRET (acima) também protege /api/cron/indices, que reimporta o IPCA do IBGE nos dias 11 e 16.
